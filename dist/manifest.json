{
  "manifest_version": 3,
  "name": "Family Tree Exporter",
  "version": "0.1.0",
  "description": "Export a FamilySearch pedigree to PDF.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://www.familysearch.org/*"],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Family Tree Exporter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.familysearch.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
